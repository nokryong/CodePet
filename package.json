{
  "name": "code-pet",
  "version": "1.2.2",
  "private": false,
  "description": "Multi-provider desktop companion for Codex, Antigravity, Claude, and Grok.",
  "desktopName": "CodePet.desktop",
  "main": "src/main.js",
  "license": "MIT",
  "bin": {
    "code-pet": "bin/code-pet.js"
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "src/**/*.js",
    "src/**/*.cs",
    "src/**/*.html",
    "src/**/*.css",
    "src/**/*.json",
    "src/**/*.png",
    "src/**/*.webp",
    "src/docker/grok/Dockerfile",
    "src/docker/grok/codepet-grok-*",
    "bin/code-pet.js",
    "build/icon.ico",
    "build/icon.png"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "dist": "node scripts/build.js"
  },
  "build": {
    "appId": "app.codepet.desktop",
    "productName": "CodePet",
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "THIRD_PARTY_NOTICES.md",
      "src/**/*.js",
      "src/**/*.cs",
      "src/**/*.html",
      "src/**/*.css",
      "src/**/*.json",
      "src/**/*.png",
      "src/**/*.webp",
      "src/docker/grok/Dockerfile",
      "src/docker/grok/codepet-grok-*",
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "CodePet-${version}.exe"
    },
    "mac": {
      "icon": "build/icon-mac.png",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "CodePet-${version}-mac-universal.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Desktop companion for Codex, Antigravity, Claude, and Grok",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "artifactName": "CodePet-${version}-${arch}.${ext}"
    }
  },
  "optionalDependencies": {
    "electron": "44.9.3"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3"
  }
}
